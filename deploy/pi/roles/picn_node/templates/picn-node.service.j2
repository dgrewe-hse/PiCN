# Generated by picn_node. Serving roles run until SIGTERM (systemd stop);
# graceful stop is bounded in serve_edge (5 s) — TimeoutStopSec covers the rest.
[Unit]
Description=PiCN Experiment E node ({{ picn_role }} on {{ inventory_hostname }})
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type={{ 'oneshot' if picn_role == 'intake' else 'simple' }}
RemainAfterExit={{ 'true' if picn_role == 'intake' else 'false' }}
User={{ picn_user }}
Group={{ picn_group }}
EnvironmentFile=/etc/picn/picn-node.env
WorkingDirectory={{ picn_repo_dir }}
ExecStart={{ picn_venv_path }}/bin/python -m demo.physical_node
KillSignal=SIGTERM
TimeoutStopSec=30
Restart={{ 'no' if picn_role == 'intake' else 'on-failure' }}
RestartSec=5

[Install]
WantedBy=multi-user.target
